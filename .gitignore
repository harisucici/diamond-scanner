# Dependencies
node_modules/
package-lock.json

# Production build
dist/
build/

# Database files
# 生产环境需要数据库文件，只忽略开发时的大文件
# db/*.sqlite  # 已注释，允许提交数据库
# db/*.db
!db/.gitkeep

# LanceDB 数据文件（运行时生成，不应提交）
lancedb/**/*.lance/
lancedb/**/_transactions/
lancedb/**/_versions/
lancedb/**/_deletions/
lancedb/**/data/
!lancedb/.gitkeep

# 如果数据库太大，使用以下策略：
# 1. 小于 50MB: 直接提交到 Git
# 2. 大于 50MB: 使用 Git LFS 或云存储

# Environment variables
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
.joycode/

# Logs
*.log
logs/

# OS
.DS_Store
Thumbs.db

# PID files
*.pid
.backend.pid
.frontend.pid

# Temp files
*.tmp
*.temp

# Debug files
debug-*.js
test-*.js
